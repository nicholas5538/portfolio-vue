{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node --experimental-strip-types \"$CLAUDE_PROJECT_DIR/.claude/hooks/run-unit-tests.ts\" snapshot",
            "timeout": 30
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node --experimental-strip-types \"$CLAUDE_PROJECT_DIR/.claude/hooks/run-unit-tests.ts\" check",
            "timeout": 180,
            "statusMessage": "Checking for code changes to test"
          }
        ]
      }
    ]
  }
}
