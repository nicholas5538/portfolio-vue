{
  "name": "portfolio-vue",
  "author": "nicholas5538",
  "private": true,
  "type": "module",
  "scripts": {
    "analyze": "nuxt analyze",
    "build": "nuxt build",
    "dev": "nuxt dev",
    "format": "prettier . --check",
    "format:fix": "prettier . --write",
    "generate": "nuxt generate",
    "graphql": "node --env-file=.env --experimental-strip-types generate-graphql-files.ts",
    "graphql:cache": "gql-tada turbo -w",
    "graphql:check": "gql-tada check -w",
    "graphql:doctor": "gql-tada doctor",
    "graphql:schema": "gql-tada generate-schema",
    "graphql:type": "gql-tada generate-output",
    "lint": "eslint --color .",
    "lint:fix": "eslint --fix .",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "prepare": "node --experimental-strip-types .husky/install.ts",
    "test": "vitest --watch=false",
    "test:watch": "vitest -w",
    "test:cov": "vitest run --coverage",
    "test-e2e": "playwright test",
    "test-e2e:ci": "playwright test --fail-on-flaky-tests",
    "test-e2e:debug": "playwright test --debug",
    "test-e2e:desktop": "playwright test --grep @desktop",
    "test-e2e:mobile": "playwright test --grep @mobile",
    "test-e2e:ui": "playwright test --ui",
    "typecheck": "nuxt prepare && vue-tsc -b --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1000.0",
    "@aws-sdk/s3-request-presigner": "3.1000.0",
    "@lottiefiles/dotlottie-vue": "0.11.27",
    "@nuxt/image": "2.1.0",
    "browserslist": "4.28.8",
    "gql.tada": "1.11.3",
    "graphql": "17.0.2",
    "nuxt": "4.5.2",
    "radix-vue": "1.9.17",
    "sharp": "0.35.4",
    "tailwind-merge": "3.6.0",
    "vue": "3.5.42",
    "vue-router": "5.3.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@gql.tada/vue-support": "1.0.3",
    "@graphql-typed-document-node/core": "3.2.0",
    "@nuxt/eslint": "1.17.0",
    "@nuxt/eslint-config": "1.17.0",
    "@nuxt/test-utils": "4.2.0",
    "@nuxtjs/google-fonts": "3.2.0",
    "@playwright/test": "1.62.1",
    "@tailwindcss/vite": "4.3.3",
    "@vitest/coverage-v8": "4.1.11",
    "@vue/test-utils": "2.5.0",
    "eslint": "10.9.1",
    "eslint-config-prettier": "10.1.8",
    "execa": "10.0.1",
    "get-tsconfig": "4.14.3",
    "happy-dom": "20.12.0",
    "husky": "9.1.7",
    "iconify-icon": "3.0.2",
    "lightningcss": "1.33.0",
    "lint-staged": "17.4.1",
    "playwright-core": "1.62.1",
    "prettier": "3.9.6",
    "prettier-plugin-tailwindcss": "0.8.1",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vitest": "4.1.11",
    "vitest-canvas-mock": "1.1.5",
    "vue-tsc": "3.3.11"
  },
  "packageManager": "pnpm@11.24.0+sha512.bd27e345e976dcb0be0b7a1228217b049a817e21b1f355c90dbe7dc46671895a8bc1e6d06c24554505ea93ea0b45f489a27ec1bfbc8de6a9659fca0f16fa0000"
}
