{
  "name": "portfolio-vue",
  "author": "nicholas5538",
  "private": true,
  "type": "module",
  "scripts": {
    "analyze": "nuxt analyze",
    "build": "nuxt build",
    "dev": "nuxt dev",
    "format": "prettier . --check",
    "format:fix": "prettier . --write",
    "generate": "nuxt generate",
    "graphql": "node --env-file=.env --experimental-strip-types generate-graphql-files.ts",
    "graphql:cache": "gql-tada turbo -w",
    "graphql:check": "gql-tada check -w",
    "graphql:doctor": "gql-tada doctor",
    "graphql:schema": "gql-tada generate-schema",
    "graphql:type": "gql-tada generate-output",
    "lint": "eslint --color .",
    "lint:fix": "eslint --fix .",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "prepare": "node --experimental-strip-types .husky/install.ts",
    "test": "vitest --watch=false",
    "test:watch": "vitest -w",
    "test:cov": "vitest run --coverage",
    "test-e2e": "playwright test",
    "test-e2e:ci": "playwright test --fail-on-flaky-tests",
    "test-e2e:debug": "playwright test --debug",
    "test-e2e:desktop": "playwright test --grep @desktop",
    "test-e2e:mobile": "playwright test --grep @mobile",
    "test-e2e:ui": "playwright test --ui",
    "typecheck": "nuxt prepare && vue-tsc -b --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1156.0",
    "@aws-sdk/s3-request-presigner": "3.1156.0",
    "@lottiefiles/dotlottie-vue": "0.11.28",
    "@nuxt/image": "2.1.0",
    "browserslist": "4.29.3",
    "gql.tada": "1.11.4",
    "graphql": "17.0.2",
    "nuxt": "4.6.2",
    "radix-vue": "1.9.17",
    "sharp": "0.35.5",
    "tailwind-merge": "3.7.0",
    "vue": "3.5.44",
    "vue-router": "5.4.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@gql.tada/vue-support": "1.0.3",
    "@graphql-typed-document-node/core": "3.2.0",
    "@nuxt/eslint": "1.17.0",
    "@nuxt/eslint-config": "1.17.0",
    "@nuxt/test-utils": "4.3.4",
    "@nuxtjs/google-fonts": "3.2.0",
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "26.6.5",
    "@vitest/coverage-v8": "5.0.5",
    "@vue/test-utils": "2.5.1",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "execa": "10.1.1",
    "get-tsconfig": "4.14.3",
    "happy-dom": "21.0.3",
    "husky": "9.1.7",
    "iconify-icon": "3.0.3",
    "lightningcss": "1.33.0",
    "lint-staged": "17.6.0",
    "playwright-core": "1.64.1",
    "prettier": "3.9.10",
    "prettier-plugin-tailwindcss": "0.8.1",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vitest": "5.0.5",
    "vitest-canvas-mock": "1.2.0",
    "vue-tsc": "3.3.13"
  },
  "packageManager": "pnpm@12.14.0+sha512.c18ba6d87993d3d164cb5e8948f32b2c06ee854487e06cd8d86781342fb3e5bb4634367034711e86802baa9c37bea906ce1929ad08d70884c97d801df13389a6"
}
